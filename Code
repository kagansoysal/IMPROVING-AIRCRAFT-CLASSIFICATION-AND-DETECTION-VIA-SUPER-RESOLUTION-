    "## CONVERTING DATASET TO YOLO FORMAT AND PREPROCESSING"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "iCBdEKqfx68M",
   "metadata": {
    "id": "iCBdEKqfx68M"
