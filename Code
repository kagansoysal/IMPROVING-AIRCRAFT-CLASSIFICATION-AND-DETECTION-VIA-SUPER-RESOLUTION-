    "def pad_img(img, desired_size=(64, 64)):\n",
    "    old_w, old_h = img.size\n",
    "    mx = max(old_w, old_h)\n",
    "    pad = Image.new('RGB', (mx, mx), color=(0,0,0))\n",
    "    pad.paste(img, ((mx - old_w)//2, (mx - old_h)//2))\n",
    "    return pad.resize(desired_size)"
   ]
  },
