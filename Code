   "source": [
    "split_txts = {\n",
    "    \"train\": f\"{yolov8obb_parse_path}/train.txt\",\n",
    "    \"val\": f\"{yolov8obb_parse_path}/val.txt\",\n",
    "    \"test\": f\"{yolov8obb_parse_path}/test.txt\"\n",
    "}\n",
    "class_to_id = {name: i for i, name in enumerate(classes)}\n",
    "\n",
    "for split, txt_path in split_txts.items():\n",
    "    with open(txt_path, \"r\") as f:\n",
    "        image_ids = [line.strip() for line in f.readlines()]\n",
    "\n",
    "    output_path = os.path.join(yolov8obb_path, split)\n",
    "    os.makedirs(output_path, exist_ok=True)\n",
    "\n",
    "    for image_id in tqdm(image_ids, desc=f\"Creating txt files for {split} images\"):\n",
    "        xml_path = os.path.join(annotations_path, f\"{image_id}.xml\")\n",
    "\n",
    "        tree = ET.parse(xml_path)\n",
    "        root = tree.getroot()\n",
    "        objects = root.findall(\"object\")\n",
    "\n",
    "        org_width, org_height = int(root.find(\"size/width\").text), int(root.find(\"size/height\").text)\n",
    "        if (org_width, org_height) != most_common_size[0]:\n",
    "            continue\n",
    "        width, height = org_width // 4, org_height // 4\n",
    "\n",
    "        label_lines = []\n",
    "        for obj in objects:\n",
    "            robndbox = obj.find(\"robndbox\")\n",
    "            if robndbox is None:\n",
    "                continue\n",
    "            poly = [\n",
    "                float(robndbox.find(\"x_left_top\").text) / 4,\n",
    "                float(robndbox.find(\"y_left_top\").text) / 4,\n",
    "                float(robndbox.find(\"x_right_top\").text) / 4,\n",
    "                float(robndbox.find(\"y_right_top\").text) / 4,\n",
    "                float(robndbox.find(\"x_right_bottom\").text) / 4,\n",
    "                float(robndbox.find(\"y_right_bottom\").text) / 4,\n",
    "                float(robndbox.find(\"x_left_bottom\").text) / 4,\n",
    "                float(robndbox.find(\"y_left_bottom\").text) / 4\n",
    "            ]\n",
    "\n",
    "            name = obj.find(\"name\").text.strip()\n",
    "            class_id = class_to_id[name]\n",
    "\n",
    "            normalized_poly = []\n",
    "            for i in range(0, len(poly), 2):\n",
    "                x, y = poly[i] / width, poly[i + 1] / height\n",
    "                normalized_poly.extend([x, y])\n",
    "\n",
    "            line = f\"{class_id} \" + \" \".join([f\"{v:.6f}\" for v in normalized_poly])\n",
    "            label_lines.append(line)\n",
    "\n",
    "        out_path = os.path.join(output_path, f\"{image_id}.txt\")\n",
    "        with open(out_path, \"w\") as out_f:\n",
    "            out_f.write(\"\\n\".join(label_lines) + \"\\n\")"
   ]
