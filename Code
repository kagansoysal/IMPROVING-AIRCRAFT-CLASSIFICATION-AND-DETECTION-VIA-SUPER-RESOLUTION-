    "def ema_and_mse(model_name):\n",
    "    base_path = '/content/drive/MyDrive/yolo_dataset/'\n",
    "    images_dir = os.path.join(base_path, f'images/test')\n",
    "    labels_dir = os.path.join(base_path, 'labels/test')\n",
    "\n",
    "\n",
    "    image_files = [f for f in os.listdir(images_dir) if f.endswith('.jpg') or f.endswith('.png')]\n",
    "    image_files.sort()\n",
    "\n",
    "    class_names = [\n",
    "      'A1', 'A10', 'A11', 'A12', 'A13', 'A14', 'A15', 'A16', 'A17', 'A18',\n",
    "      'A19', 'A2', 'A20', 'A3', 'A4', 'A5', 'A6', 'A7', 'A8', 'A9'\n",
    "    ]\n",
    "\n",
    "    model_path = f'/content/runs/detect/{model_name}/weights/best.pt'\n",
    "    model = YOLO(model_path)\n",
    "\n",
    "\n",
    "    exact_matches = defaultdict(int)\n",
    "    total_counts = defaultdict(int)\n",
    "    mse_errors = defaultdict(list)\n",
    "\n",
    "    for image_file in image_files:\n",
    "        image_path = os.path.join(images_dir, image_file)\n",
    "        label_path = os.path.join(labels_dir, image_file.replace('.jpg', '.txt').replace('.png', '.txt'))\n",
    "\n",
    "        gt_per_class = defaultdict(int)\n",
    "        if os.path.exists(label_path):\n",
    "            with open(label_path, 'r') as f:\n",
    "                for line in f:\n",
    "                    cls_id = int(float(line.strip().split()[0]))\n",
    "                    gt_per_class[cls_id] += 1\n",
    "\n",
    "        result = model(image_path, verbose=False)[0]\n",
    "        pred_per_class = defaultdict(int)\n",
    "        for cls_id in result.boxes.cls.cpu().numpy().astype(int):\n",
    "            pred_per_class[cls_id] += 1\n",
    "\n",
    "        all_classes = set(gt_per_class.keys()) | set(pred_per_class.keys())\n",
    "        for cls_id in all_classes:\n",
    "            gt = gt_per_class[cls_id]\n",
    "            pred = pred_per_class[cls_id]\n",
    "            total_counts[cls_id] += 1\n",
    "            if gt == pred:\n",
    "                exact_matches[cls_id] += 1\n",
    "            mse_errors[cls_id].append((gt - pred) ** 2)\n",
    "\n",
    "    classes = sorted(total_counts.keys())\n",
    "    ema_values = [(exact_matches[c] / total_counts[c]) * 100 for c in classes]\n",
    "    mse_values = [np.mean(mse_errors[c]) for c in classes]\n",
    "    labels = [class_names[c] if c < len(class_names) else f\"Class {c}\" for c in classes]\n",
    "\n",
    "    x = np.arange(len(classes))\n",
    "    width = 0.35\n",
    "\n",
    "    fig, ax1 = plt.subplots(figsize=(6, 4))\n",
    "\n",
    "    bar1 = ax1.bar(x - width/2, ema_values, width, label='Exact Match Accuracy (%)', color='skyblue')\n",
    "    ax1.set_ylabel('Exact Match Accuracy (%)', color='skyblue')\n",
    "    ax1.set_ylim(0, 100)\n",
    "    ax1.set_title('Exact Match Accuracy and MSE per Class')\n",
    "    ax1.set_xticks(x)\n",
    "    ax1.set_xticklabels(labels, rotation=45, ha='right')\n",
    "\n",
    "    ax2 = ax1.twinx()\n",
    "    bar2 = ax2.bar(x + width/2, mse_values, width, label='MSE', color='orange')\n",
    "    ax2.set_ylabel('Mean Squared Error', color='orange')\n",
    "\n",
    "    fig.tight_layout()\n",
    "    plt.legend(handles=[bar1, bar2], loc='upper right')\n",
    "    plt.grid(axis='y', linestyle='--', alpha=0.5)\n",
    "    plt.show()"
   ]
