    "def visualize_all_three(model_name, image_names, iou_threshold=0.5):\n",
    "    def compute_iou(box1, box2):\n",
    "        xi1 = max(box1[0], box2[0])\n",
    "        yi1 = max(box1[1], box2[1])\n",
    "        xi2 = min(box1[2], box2[2])\n",
    "        yi2 = min(box1[3], box2[3])\n",
    "        inter_area = max(0, xi2 - xi1) * max(0, yi2 - yi1)\n",
    "        box1_area = (box1[2] - box1[0]) * (box1[3] - box1[1])\n",
    "        box2_area = (box2[2] - box2[0]) * (box2[3] - box2[1])\n",
    "        union_area = box1_area + box2_area - inter_area\n",
    "        return inter_area / union_area if union_area != 0 else 0\n",
    "\n",
    "    model_path = f'/content/runs/detect/{model_name}/weights/best.pt'\n",
    "    model = YOLO(model_path)\n",
    "\n",
    "    for image_name in image_names:\n",
    "        image_path = f'/content/drive/MyDrive/yolo_dataset/images/test/{image_name}'\n",
    "        label_path = f'/content/drive/MyDrive/yolo_dataset/labels/test/{image_name.replace(\".jpg\", \".txt\").replace(\".png\", \".txt\")}'\n",
    "\n",
    "        img_gt = cv2.imread(image_path)\n",
    "        img_gt = cv2.cvtColor(img_gt, cv2.COLOR_BGR2RGB)\n",
    "        img_copy = img_gt.copy()\n",
    "        h, w, _ = img_gt.shape\n",
    "\n",
    "        gt_boxes = []\n",
    "        if os.path.exists(label_path):\n",
    "            with open(label_path, 'r') as f:\n",
    "                for line in f:\n",
    "                    cls, xc, yc, bw, bh = map(float, line.strip().split())\n",
    "                    x1 = int((xc - bw / 2) * w)\n",
    "                    y1 = int((yc - bh / 2) * h)\n",
    "                    x2 = int((xc + bw / 2) * w)\n",
    "                    y2 = int((yc + bh / 2) * h)\n",
    "                    gt_boxes.append([x1, y1, x2, y2])\n",
    "                    cv2.rectangle(img_gt, (x1, y1), (x2, y2), (0, 255, 0), 1)\n",
    "\n",
    "        results = model(image_path, verbose=False)[0]\n",
    "        pred_boxes = results.boxes.xyxy.cpu().numpy()\n",
    "        conf_scores = results.boxes.conf.cpu().numpy()\n",
    "\n",
    "        img_pred = img_copy.copy()\n",
    "        for (x1, y1, x2, y2), conf in zip(pred_boxes, conf_scores):\n",
    "            x1, y1, x2, y2 = map(int, (x1, y1, x2, y2))\n",
    "            cv2.rectangle(img_pred, (x1, y1), (x2, y2), (255, 255, 0), 1)\n",
    "\n",
    "        img_eval = img_copy.copy()\n",
    "        matched_gt = [False] * len(gt_boxes)\n",
    "\n",
    "        for pred_box in pred_boxes:\n",
    "            x1, y1, x2, y2 = map(int, pred_box[:4])\n",
    "            color = (255, 0, 0)\n",
    "            for j, gt in enumerate(gt_boxes):\n",
    "                iou = compute_iou([x1, y1, x2, y2], gt)\n",
    "                if iou >= iou_threshold and not matched_gt[j]:\n",
    "                    matched_gt[j] = True\n",
    "                    color = (0, 255, 0)\n",
    "                    break\n",
    "            cv2.rectangle(img_eval, (x1, y1), (x2, y2), color, 1)\n",
    "\n",
    "        for i, matched in enumerate(matched_gt):\n",
    "            if not matched:\n",
    "                x1, y1, x2, y2 = gt_boxes[i]\n",
    "                cv2.rectangle(img_eval, (x1, y1), (x2, y2), (0, 0, 255), 1)\n",
    "\n",
    "        plt.figure(figsize=(13, 5))\n",
    "\n",
    "        plt.subplot(1, 3, 1)\n",
    "        plt.imshow(img_gt)\n",
    "        plt.title(\"Ground Truth (Green)\")\n",
    "        plt.axis('off')\n",
    "\n",
    "        plt.subplot(1, 3, 2)\n",
    "        plt.imshow(img_pred)\n",
    "        plt.title(\"YOLO Prediction\")\n",
    "        plt.axis('off')\n",
    "\n",
    "        plt.subplot(1, 3, 3)\n",
    "        plt.imshow(img_eval)\n",
