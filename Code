    "def obb_iou(poly1, poly2):\n",
    "    poly1, poly2 = Polygon(poly1), Polygon(poly2)\n",
    "    if not poly1.is_valid or not poly2.is_valid:\n",
    "        return 0.0\n",
    "    inter = poly1.intersection(poly2).area\n",
    "    union = poly1.union(poly2).area\n",
    "    return inter / union if union != 0 else 0\n",
    "\n",
    "wrong_images = [img for img in test_images if ground_truth_counts.get(img, 0) != prediction_counts.get(img, -1)]\n",
    "\n",
    "for img_path in wrong_images[:5]:\n",
    "    img = cv2.imread(img_path)\n",
    "    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
    "    h, w = img.shape[:2]\n",
    "\n",
    "    result = model.predict(source=img_path, conf=0.25, verbose=False)[0]\n",
    "    if result.obb and result.obb.xywhr is not None:\n",
    "        obb_raw = result.obb.xywhr.cpu().numpy()\n",
    "        pred_boxes = []\n",
    "        for obb in obb_raw:\n",
    "            cx, cy, bw, bh, angle = obb\n",
    "            rect = ((cx, cy), (bw, bh), np.degrees(angle))\n",
    "            box = cv2.boxPoints(rect)\n",
    "            pred_boxes.append(box)\n",
    "    else:\n",
    "        pred_boxes = []\n",
    "\n",
    "    base = os.path.splitext(os.path.basename(img_path))[0]\n",
    "    txt_path = os.path.join(test_path, base + \".txt\")\n",
    "    gt_boxes = []\n",
    "    with open(txt_path, \"r\") as f:\n",
    "        for line in f:\n",
    "            parts = list(map(float, line.strip().split()))\n",
    "            coords = parts[1:]\n",
    "            coords = [coords[i] * w if i % 2 == 0 else coords[i] * h for i in range(8)]\n",
    "            gt_boxes.append(coords)\n",
    "\n",
    "    matched_gt = [False] * len(gt_boxes)\n",
    "    matched_pred = [False] * len(pred_boxes)\n",
    "    TP, FP, FN = [], [], []\n",
    "\n",
    "    for pi, pred in enumerate(pred_boxes):\n",
    "        pred_poly = pred.reshape(-1, 2)\n",
    "        found_match = False\n",
    "        for gi, gt in enumerate(gt_boxes):\n",
    "            gt_poly = np.array(gt).reshape(-1, 2)\n",
    "            iou = obb_iou(pred_poly, gt_poly)\n",
    "            if iou > 0.7 and not matched_gt[gi]:\n",
    "                TP.append(pred_poly)\n",
