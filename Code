   "source": [
    "data_dir = 'Data'\n",
    "\n",
    "def read_annotations(xml_path):\n",
    "    tree = ET.parse(xml_path)\n",
    "    root = tree.getroot()\n",
    "    annotations = []\n",
    "    for obj in root.findall('object'):\n",
    "        name = obj.find('name').text\n",
    "        bbox = obj.find('bndbox')\n",
    "        xmin = int(bbox.find('xmin').text)\n",
    "        ymin = int(bbox.find('ymin').text)\n",
    "        xmax = int(bbox.find('xmax').text)\n",
    "        ymax = int(bbox.find('ymax').text)\n",
    "        annotations.append((name, (xmin, ymin, xmax, ymax)))\n",
    "    return annotations\n",
    "\n",
    "def read_data(file_names):\n",
    "    data = []\n",
    "    for file_name in file_names:\n",
    "        img_path = os.path.join(data_dir, 'JPEGImages', file_name + '.jpg')\n",
    "        xml_path = os.path.join(data_dir, 'Annotations', 'Horizontal Bounding Boxes', file_name + '.xml')\n",
    "        if not os.path.exists(img_path) or not os.path.exists(xml_path):\n",
    "            continue\n",
    "        img = Image.open(img_path)\n",
    "        arr = np.array(img)\n",
    "        if arr.ndim != 3 or arr.shape[2] != 3:\n",
    "            continue\n",
    "        annotations = read_annotations(xml_path)\n",
    "        data.append((img, annotations))\n",
    "    return data\n",
    "\n",
    "# Load train/test file lists\n",
    "with open(os.path.join(data_dir, 'ImageSets', 'Main', 'train.txt'), 'r') as f:\n",
    "    train_files = f.read().splitlines()\n",
    "with open(os.path.join(data_dir, 'ImageSets', 'Main', 'test.txt'), 'r') as f:\n",
    "    test_files  = f.read().splitlines()\n",
    "\n",
    "train_data = read_data(train_files)\n",
    "test_data  = read_data(test_files)\n",
    "\n",
    "# Show one sample with bounding boxes drawn\n",
    "example_img = train_data[0][0].copy()\n",
    "draw = ImageDraw.Draw(example_img)\n",
    "for obj in train_data[0][1]:\n",
    "    draw.rectangle(obj[1], outline='red')\n",
    "    draw.text((obj[1][0], obj[1][1]), obj[0], fill='red')\n"
