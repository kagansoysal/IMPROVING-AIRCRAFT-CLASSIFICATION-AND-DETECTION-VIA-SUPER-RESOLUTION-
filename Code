    "def preprocess_sr_all(data, label_to_int):\n",
    "    X_list, y_list = [], []\n",
    "    for img, annots in data:\n",
    "        for label, bbox in annots:\n",
    "            roi = img.crop(bbox)\n",
    "            roi_bgr = cv2.cvtColor(np.array(roi), cv2.COLOR_RGB2BGR)\n",
    "            sr_bgr = sr.upsample(roi_bgr)\n",
    "            sr_rgb = cv2.cvtColor(sr_bgr, cv2.COLOR_BGR2RGB)\n",
    "            sr_pil = Image.fromarray(sr_rgb)\n",
    "            final = pad_and_resize(sr_pil)\n",
    "            X_list.append(np.array(final) / 255.0)\n",
    "            y_list.append(label_to_int[label])\n",
    "    return np.stack(X_list, 0), np.array(y_list)"
   ]
