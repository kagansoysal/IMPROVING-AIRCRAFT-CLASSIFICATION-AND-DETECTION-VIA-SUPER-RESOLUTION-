   "source": [
    "def extract_objs(img, annots):\n",
    "    crops, labels = [], []\n",
    "    for label, bbox in annots:\n",
    "        roi = img.crop(bbox)\n",
    "        crops.append(roi)\n",
    "        labels.append(label)\n",
    "    return crops, labels"
   ]
  },
