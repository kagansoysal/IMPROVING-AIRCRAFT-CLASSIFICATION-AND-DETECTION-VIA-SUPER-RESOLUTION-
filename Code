   "outputs": [],
   "source": [
    "def preprocess_dataset(data, desired_size=(64,64)):\n",
    "    X_list, y_labels = [], []\n",
    "    for img, annots in data:\n",
    "        objs, labels = extract_objs(img, annots)\n",
    "        for obj, label in zip(objs, labels):\n",
    "            X_list.append(np.array(pad_img(obj, desired_size)) / 255.0)\n",
    "            y_labels.append(label)\n",
    "    X = np.stack(X_list, axis=0)  # shape (N,H,W,3)\n",
    "    y = np.array(y_labels)        # shape (N,)\n",
    "    return X, y"
   ]
