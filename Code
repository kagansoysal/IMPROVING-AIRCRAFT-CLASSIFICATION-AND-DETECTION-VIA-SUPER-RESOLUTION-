    "def pad_and_resize(img: Image.Image, size=(224, 224)) -> Image.Image:\n",
    "    w, h = img.size\n",
    "    m = max(w, h)\n",
    "    canvas = Image.new(\"RGB\", (m, m), (0, 0, 0))\n",
    "    canvas.paste(img, ((m - w) // 2, (m - h) // 2))\n",
    "    return canvas.resize(size)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e3fabb10",
   "metadata": {
    "id": "e3fabb10"
   },
   "source": [
