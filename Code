   "outputs": [],
   "source": [
    "base_dir = Path(\"Data\")\n",
    "jpeg_dir = base_dir / \"JPEGImages\"\n",
    "ann_dir = base_dir / \"Annotations\" / \"Horizontal Bounding Boxes\"\n",
    "sets_dir = base_dir / \"ImageSets\" / \"Main\"\n",
    "\n",
    "output_base = Path(\"/content/MyDrive/yolo_dataset\")\n",
    "images_dir = output_base / \"images\"\n",
    "labels_dir = output_base / \"labels\"\n",
    "images_dir.mkdir(parents=True, exist_ok=True)\n",
    "labels_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "for split in [\"train\", \"test\"]:\n",
    "    (images_dir / split).mkdir(parents=True, exist_ok=True)\n",
    "    (labels_dir / split).mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "class_names = set()\n",
    "\n",
    "def convert_annotation(xml_path):\n",
    "    tree = ET.parse(xml_path)\n",
    "    root = tree.getroot()\n",
    "\n",
    "    size_tag = root.find('size')\n",
    "    w = int(size_tag.find('width').text)\n",
    "    h = int(size_tag.find('height').text)\n",
    "\n",
    "    if w == 0 or h == 0:\n",
    "        print(f\"⚠️ Warning: The file {xml_path.name} has a width or height value of 0. Skipping.\")\n",
    "        return None\n",
    "\n",
    "    yolo_labels = []\n",
    "\n",
    "    for obj in root.findall('object'):\n",
    "        cls = obj.find('name').text\n",
    "        class_names.add(cls)\n",
    "\n",
    "        bbox = obj.find('bndbox')\n",
    "        xmin = int(bbox.find('xmin').text)\n",
    "        ymin = int(bbox.find('ymin').text)\n",
    "        xmax = int(bbox.find('xmax').text)\n",
    "        ymax = int(bbox.find('ymax').text)\n",
    "\n",
    "        x_center = ((xmin + xmax) / 2) / w\n",
    "        y_center = ((ymin + ymax) / 2) / h\n",
    "        width = (xmax - xmin) / w\n",
    "        height = (ymax - ymin) / h\n",
    "\n",
    "        yolo_labels.append((cls, x_center, y_center, width, height))\n",
    "\n",
    "    return yolo_labels\n",
    "\n",
    "labels_temp_dir = base_dir / \"labels_temp\"\n",
    "labels_temp_dir.mkdir(exist_ok=True)\n",
    "\n",
    "for xml_file in ann_dir.glob(\"*.xml\"):\n",
    "    image_id = xml_file.stem\n",
    "    yolo_data = convert_annotation(xml_file)\n",
    "    if yolo_data is None:\n",
    "        continue\n",
    "\n",
    "    label_path = labels_temp_dir / f\"{image_id}.txt\"\n",
    "    with open(label_path, \"w\") as f:\n",
    "        for cls, x, y, w, h in yolo_data:\n",
    "            f.write(f\"{cls} {x:.6f} {y:.6f} {w:.6f} {h:.6f}\\n\")\n",
    "\n",
    "sorted_classes = sorted(class_names)\n",
    "class_to_index = {name: i for i, name in enumerate(sorted_classes)}\n",
    "\n",
    "for label_file in labels_temp_dir.glob(\"*.txt\"):\n",
    "    lines = label_file.read_text().strip().split(\"\\n\")\n",
    "    new_lines = []\n",
    "    for line in lines:\n",
    "        cls_name, x, y, w, h = line.split()\n",
    "        cls_id = class_to_index[cls_name]\n",
    "        new_lines.append(f\"{cls_id} {x} {y} {w} {h}\")\n",
    "    label_file.write_text(\"\\n\".join(new_lines))\n",
    "\n",
    "def process_split(split):\n",
    "    split_file = sets_dir / f\"{split}.txt\"\n",
    "    with open(split_file, \"r\") as f:\n",
    "        image_ids = [line.strip() for line in f.readlines()]\n",
    "\n",
    "    for image_id in image_ids:\n",
    "        src_img = jpeg_dir / f\"{image_id}.jpg\"\n",
    "        dst_img = images_dir / split / f\"{image_id}.jpg\"\n",
    "        if src_img.exists():\n",
    "            copyfile(src_img, dst_img)\n",
    "\n",
    "        src_lbl = labels_temp_dir / f\"{image_id}.txt\"\n",
    "        dst_lbl = labels_dir / split / f\"{image_id}.txt\"\n",
    "        if src_lbl.exists():\n",
    "            copyfile(src_lbl, dst_lbl)\n",
    "\n",
    "process_split(\"train\")\n",
    "process_split(\"test\")\n",
    "\n",
    "yaml_path = output_base / \"data.yaml\"\n",
    "yaml_path.write_text(\n",
    "    f\"train: {images_dir/'train'}\\n\"\n",
    "    f\"test: {images_dir/'test'}\\n\"\n",
    "    f\"val: {images_dir/'val'}\\n\\n\"\n",
    "    f\"nc: {len(sorted_classes)}\\n\"\n",
    "    f\"names: {sorted_classes}\\n\"\n",
    ")\n",
    "\n",
    "print(f\"Classes: {sorted_classes}\")"
   ]
